<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}
				{{ title|default('Accueil') }}
			{% endblock title %}
			|- trips
		</title>

		<link rel="stylesheet" href="css/style.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"> {% block css %}{% endblock %}
		</head>
		<body>
			<header>
				<nav class="navbar" aria-label="Main Navigation">
					<a class="logo" href="./">Trips</a>
					<h1 class="visually_hidden">Trips</h1>
					
					<div class="bi-list"></div>

					<ul class="nav-actions">
						<li>
							<a href="./">Accueil</a>
						</li>
						<li>
							<a href="#">Activites</a>
							<ul class="dropdown">
								<li>
									<a href="activites_par_ville.php">Activités par ville</a>
								</li>
								<li>
									<a href="activites_par_categorie.php">Activités par catégorie</a>
								</li>
							</ul>
						</li>
						<li>
							<a href="a_propos.php">A Propos</a>
						</li>
						<li>
							<a href="contact.php">Contact</a>
						</li>
					</ul>
				</nav>
			</header>
			<main>
				{% block main %}
					<!-- HERO -->
					<section class="hero" aria-label="Hero Section">
						<div class="hero-content" role="article">
							<h1>Discover the world's best experiences</h1>

							<div class="search-bar" role="search">
								<input type="text" placeholder="Search destinations &amp; experiences">
							</div>

							<div
								class="hero-badge" role="note">
								<!-- Ticket icon -->
								More than 50 million happy travelers booked with Tiqets
							</div>
						</div>
					</section>

					<!-- FEATURE CARDS -->
					<section
						class="features" aria-label="Features Section">


						<!-- Card 1 -->
						<div class="feature-card" role="article">
							<img
							class="feature-icon flexible" src="./images/icon/cycle.png" alt="Ticket Icon">
							{# <div class="bi bi-arrow-repeat feature-icon"></div> #}
							<div>

								<h2>Stay flexible</h2>
								<p>Flexible cancellation options on all venues</p>
							</div>
						</div>

						<!-- Card 2 -->
						<div class="feature-card" role="article">


							<div class="bi bi-patch-check feature-icon confidence"></div>
							<div>
								<h2>Book with confidence</h2>
								<p>Easy booking and skip-the-line entry on your phone</p>
							</div>
						</div>

						<!-- Card 3 -->
						<div class="feature-card" role="article">
							<div class="bi bi-people-fill feature-icon culture"></div>
							<div>
								<h2>Enjoy culture your way</h2>
								<p>The best experiences at museums and attractions worldwide</p>
							</div>
						</div>
					</section>

					<section class="cities_in_france" aria-label="Cities in France Section">
						<h2>Découvrez les villes de France</h2>
						<div class="city-cards" role="list">
							{% for ville in villes %}

								<a class="city-card" href="">
									<div class="city-cards_img"><img src="{{ ville.ville_img }}" alt="{{ ville.nom_villes }}"></div>
									<h3>{{ ville.nom_villes }}</h3>
								</a>
							{% endfor %}
						</div>

						<div class="activites_fr_cards" role="list">
							{% for activite in activites %}
								<a class="card_activites_fr" href="detail_activite.php?id={{ activite.id_activite }}">
									<article>
										<div class="card_activites_fr_img">
											<img src="{{ activite.img }}" alt="">
										</div>
										<div class="card_activites_fr_img_content">
											<p>{{ activite.nom_villes }}</p>
											<h3>{{ activite.titre }}</h3>
											<p>{{ activite.desc }}</p>
											<div class="card_activites_fr_prix">
												<p>à partir de</p>
												<p>{{  activite.prix  }}</p>
											</div>
										</div>
									</article>
								</a>
							{% endfor %}
						</div>
					</section>

					<section class="cities_in_france" aria-label="Les meilleurs endroits à visiter dans le monde Section">
						<h2>Les meilleurs endroits à visiter dans le monde</h2>
						<div class="city-cards" role="list">
							{% for ville_fr in villes_fr %}

								<a class="city-card" href="">
									<div class="city-cards_img"><img src="{{ ville_fr.ville_img }}" alt="{{ ville_fr.nom_villes }}"></div>
									<h3>{{ ville_fr.nom_villes }}</h3>
								</a>
							{% endfor %}
						</div>

						<div class="activites_fr_cards" role="list">
							{% for hors_activite in activites_hors_fr %}
								<a class="card_activites_fr" href="">
									<article>
										<div class="card_activites_fr_img">
											<img src="{{ hors_activite.img }}" alt="">
										</div>
										<div class="card_activites_fr_img_content">
											<p>{{ hors_activite.nom_villes }}</p>
											<h3>{{ hors_activite.titre }}</h3>
											<p>{{ hors_activite.desc }}</p>
											<div class="card_activites_fr_prix">
												<h4>à partir de</h4>
												<p>{{  hors_activite.prix  }}</p>
											</div>
										</div>
									</article>
								</a>
							{% endfor %}
						</div>
					</section>
				{% endblock %}
			</main>
			<footer>
				<div class="footer_content">
					<div class="footer_section_about" role="article">
						<h2>Trips</h2>
						<p>Trips est un site web dédié aux voyages, offrant une plateforme pour découvrir et réserver des activités passionnantes à travers le monde. Que vous soyez à la recherche d'aventures en plein air, de visites culturelles ou d'expériences uniques, Trips vous propose une sélection soigneusement choisie pour rendre vos voyages inoubliables.</p>


						<nav class="footer_section_nav" aria-label="Footer Navigation">
							<ul class="nav_actions_footer">
								<li>
									<a href="./">Accueil</a>
								</li>
								<li>
									<a href="activites_par_ville.php">Activites</a>
								</li>
								<li>
									<a href="a_propos.php">A Propos</a>
								</li>
								<li>
									<a href="contact.php">Contact</a>
								</li>
							</ul>
						</nav>

						<div class="footer_section_social" role="navigation" aria-label="Social Media Links">
							<a href="#">
								<i class="bi bi-facebook"></i>
							</a>
							<a href="#">
								<i class="bi bi-twitter"></i>
							</a>
							<a href="#">
								<i class="bi bi-instagram"></i>
							</a>
						</div>
					</div>


					<div class="footer-section_contact">
						<div class="animation-container">
							<div class="bi-globe-central-south-asia" role="animation">
								<div class="bi-android"></div>
							</div>
						</div>
						<h2>Contactez-nous</h2>
						<p>Email: example@gmail.com</p>
						<p>Téléphone: +33 123 456 789</p>
						<p>Adresse: 123 Rue de Voyage, Paris, France</p>


					</div>

				</div>
				<p>site web dédié aux voyages - par -AbdullahTayef &copy;</p>
			</footer>
		</body>
	</html>
