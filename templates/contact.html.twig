{% extends "base.html.twig" %}

{% block title %}
	{{ title|title }}
{% endblock title %}

{% block css %}
	<link rel="stylesheet" href="css/contact.css">
{% endblock %}

{% block main %}

	<section class="contact-section">

		<h2>Contact Us</h2>

		{# Display success message if it exists #}
		{% if success_message %}
			<p class="alert success">{{ success_message }}</p>
		{% endif %}

		{# Display error message if it exists #}
		{% if error_message %}
			<p class="alert error">{{ error_message }}</p>
		{% endif %}

		<form action="contact.php" method="POST">
			<div class="form-group">
				<label for="name">Name</label>
				<input type="text" id="name" name="name" required value="{{ input.name }}">
			</div>

			<div class="form-group">
				<label for="email">Email</label>
				<input type="email" id="email" name="email" required value="{{ input.email }}">
			</div>

			<div class="form-group">
				<label for="message">Message</label>
				<textarea id="message" name="message" rows="4" required>{{ input.message }}</textarea>
			</div>

			<button type="submit" name="submit">Send Message</button>
		</form>

	</section>
{% endblock %}
